#!/usr/bin/env python3
"""Local history, workspace, and session token/cache/speed statistics viewer for agy CLI."""

import argparse
import json
import os
import sys
import unicodedata
from collections import defaultdict
from datetime import datetime, timedelta
from pathlib import Path

_SCRIPT_DIR = Path(__file__).resolve().parent
if (_SCRIPT_DIR / "agy_metrics_lib.py").is_file():
    sys.path.insert(0, str(_SCRIPT_DIR))
else:
    sys.path.insert(0, str(_SCRIPT_DIR.parent))

from agy_metrics_lib import (
    BRAIN_DIR,
    CACHE_DIR,
    calc_cache_rate,
    fmt_tokens,
    fmt_usd,
    load_conversation_metadata,
    load_json_safe,
    parse_transcript_full,
    safe_id,
)


def load_all_sessions() -> list[dict]:
    sessions = []
    if not BRAIN_DIR.is_dir():
        return sessions
    meta_map = load_conversation_metadata()
    for t_path in BRAIN_DIR.glob("*/.system_generated/logs/transcript.jsonl"):
        sid = t_path.parent.parent.parent.name
        parsed = parse_transcript_full(t_path)
        if parsed["turns"] == 0 and parsed["user_turns"] == 0:
            continue
        meta = meta_map.get(sid) or {}
        parsed["session_id"] = sid
        parsed["title"] = meta.get("title") or ""
        parsed["workspaces"] = meta.get("workspaces") or []
        parsed["parent_id"] = meta.get("parent_id") or ""
        parsed["path"] = str(t_path)
        parsed["mtime"] = t_path.stat().st_mtime
        timing = load_json_safe(CACHE_DIR / f"{safe_id(sid)}.json")
        if timing.get("cum_tps") is not None:
            parsed["cum_tps"] = timing["cum_tps"]
            parsed["cum_out"] = timing.get("cum_out")
            parsed["cum_elapsed"] = timing.get("cum_elapsed")
        t_models = timing.get("by_model") or {}
        if (
            not t_models
            and timing.get("cum_out")
            and timing.get("cum_elapsed")
            and len(parsed["by_model"]) == 1
        ):
            only_model = next(iter(parsed["by_model"]))
            t_models = {only_model: {"out": timing["cum_out"], "elapsed": timing["cum_elapsed"]}}
        parsed["timing_by_model"] = t_models
        sessions.append(parsed)
    sessions.sort(key=lambda s: s["mtime"], reverse=True)
    return sessions


def fold_subagent_sessions(raw_sessions: list[dict]) -> list[dict]:
    """Fold subagent sessions into their root ancestor session."""
    by_id = {s["session_id"]: s for s in raw_sessions}

    def find_root_id(sid: str) -> str:
        cur = sid
        seen = {cur}
        while True:
            pid = (by_id.get(cur) or {}).get("parent_id") or ""
            if not pid or pid not in by_id or pid in seen:
                return cur
            seen.add(pid)
            cur = pid

    folded: dict[str, dict] = {}
    children_to_merge: list[tuple[str, dict]] = []

    for s in raw_sessions:
        root_id = find_root_id(s["session_id"])
        if root_id == s["session_id"]:
            copy_s = dict(s)
            copy_s["user_dates"] = list(s.get("user_dates") or [])
            copy_s["steps"] = list(s.get("steps") or [])
            copy_s["workspaces"] = list(s.get("workspaces") or [])
            copy_s["by_model"] = {k: dict(v) for k, v in (s.get("by_model") or {}).items()}
            copy_s["timing_by_model"] = {k: dict(v) for k, v in (s.get("timing_by_model") or {}).items()}
            copy_s["subagent_count"] = 0
            copy_s["subagent_ids"] = []
            folded[root_id] = copy_s
        else:
            children_to_merge.append((root_id, s))

    for root_id, child in children_to_merge:
        root = folded.get(root_id)
        if root is None:
            continue
        root["subagent_count"] += 1
        root["subagent_ids"].append(child["session_id"])
        root["user_turns"] += int(child.get("user_turns") or 0)
        root["turns"] += int(child.get("turns") or 0)
        root["input_tokens"] += int(child.get("input_tokens") or 0)
        root["cache_read_tokens"] += int(child.get("cache_read_tokens") or 0)
        root["output_tokens"] += int(child.get("output_tokens") or 0)
        root["est_cost_usd"] = float(root.get("est_cost_usd") or 0.0) + float(child.get("est_cost_usd") or 0.0)
        root["user_dates"].extend(child.get("user_dates") or [])
        root["steps"].extend(child.get("steps") or [])
        for ws in child.get("workspaces") or []:
            if ws not in root["workspaces"]:
                root["workspaces"].append(ws)
        if child.get("mtime", 0) > root.get("mtime", 0):
            root["mtime"] = child["mtime"]
        if child.get("last_dt") and (not root.get("last_dt") or child["last_dt"] > root["last_dt"]):
            root["last_dt"] = child["last_dt"]
        if child.get("first_dt") and (not root.get("first_dt") or child["first_dt"] < root["first_dt"]):
            root["first_dt"] = child["first_dt"]

        for m_name, mb in (child.get("by_model") or {}).items():
            rm = root["by_model"].setdefault(
                m_name,
                {"turns": 0, "input_tokens": 0, "cache_read_tokens": 0, "output_tokens": 0, "cost_usd": 0.0},
            )
            rm["turns"] += int(mb.get("turns") or 0)
            rm["input_tokens"] += int(mb.get("input_tokens") or 0)
            rm["cache_read_tokens"] += int(mb.get("cache_read_tokens") or 0)
            rm["output_tokens"] += int(mb.get("output_tokens") or 0)
            rm["cost_usd"] += float(mb.get("cost_usd") or 0.0)

        for m_name, tmb in (child.get("timing_by_model") or {}).items():
            rtm = root["timing_by_model"].setdefault(m_name, {"out": 0, "elapsed": 0.0})
            rtm["out"] = int(rtm.get("out") or 0) + int(tmb.get("out") or 0)
            rtm["elapsed"] = float(rtm.get("elapsed") or 0.0) + float(tmb.get("elapsed") or 0.0)

        c_out = int(child.get("cum_out") or 0)
        c_el = float(child.get("cum_elapsed") or 0.0)
        if c_out > 0 and c_el > 0:
            root["cum_out"] = int(root.get("cum_out") or 0) + c_out
            root["cum_elapsed"] = float(root.get("cum_elapsed") or 0.0) + c_el
            root["cum_tps"] = round(root["cum_out"] / root["cum_elapsed"], 2)

    result = list(folded.values())
    result.sort(key=lambda s: s["mtime"], reverse=True)
    return result


def match_workspace(session_workspaces: list[str], target: str, recursive: bool) -> bool:
    for ws in session_workspaces:
        if ws == target:
            return True
        if recursive:
            prefix = target.rstrip("/") + "/"
            if target == "/" or ws.startswith(prefix):
                return True
    return False


def make_bucket() -> dict:
    return {
        "sessions": 0,
        "user_turns": 0,
        "turns": 0,
        "input_tokens": 0,
        "cache_read_tokens": 0,
        "output_tokens": 0,
        "cost_usd": 0.0,
        "timed_out": 0,
        "timed_elapsed": 0.0,
    }


def add_step(bucket: dict, step: dict) -> None:
    bucket["turns"] += 1
    bucket["input_tokens"] += step["input_tokens"]
    bucket["cache_read_tokens"] += step["cache_read_tokens"]
    bucket["output_tokens"] += step["output_tokens"]
    bucket["cost_usd"] += float(step.get("cost_usd") or 0.0)


def clean_cell(text: str) -> str:
    return " ".join(str(text).split())


def disp_width(text: str) -> int:
    return sum(2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1 for ch in text)


def trunc_disp(text: str, max_w: int, from_left: bool = False) -> str:
    text = clean_cell(text)
    if disp_width(text) <= max_w:
        return text
    if max_w <= 3:
        return text[:max_w]
    if from_left:
        acc, w = [], 0
        for ch in reversed(text):
            cw = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
            if w + cw > max_w - 3:
                break
            acc.append(ch)
            w += cw
        return "..." + "".join(reversed(acc))
    acc, w = [], 0
    for ch in text:
        cw = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
        if w + cw > max_w - 3:
            break
        acc.append(ch)
        w += cw
    return "".join(acc) + "..."


def pad_cell(text: str, width: int, align: str = "left") -> str:
    w = disp_width(text)
    if w >= width:
        return text
    spaces = " " * (width - w)
    return (spaces + text) if align == "right" else (text + spaces)


def print_table(columns: list[tuple[str, int, str]], rows: list[list[str]]) -> None:
    sep = "  "
    header_line = sep.join(pad_cell(title, w, align) for title, w, align in columns)
    print(header_line)
    print("-" * disp_width(header_line))
    for row in rows:
        print(sep.join(pad_cell(val, w, align) for (_, w, align), val in zip(columns, row)))


def fmt_rate(bucket: dict) -> str:
    rate = calc_cache_rate(bucket["input_tokens"], bucket["cache_read_tokens"])
    return f"{rate:.1f}%" if rate is not None else "--"


def fmt_avg_tps(bucket: dict) -> str:
    el = float(bucket.get("timed_elapsed") or 0.0)
    out = int(bucket.get("timed_out") or 0)
    if el <= 0 or out <= 0:
        return "--"
    return f"{out / el:.1f}/s"


def bucket_columns(
    label_title: str,
    label_w: int = 14,
    show_sessions: bool = False,
    show_tps: bool = False,
    show_cost: bool = True,
) -> list[tuple[str, int, str]]:
    cols = [(label_title, label_w, "left")]
    if show_sessions:
        cols.append(("会话", 5, "right"))
    cols.extend(
        [
            ("轮/步", 11, "right"),
            ("新Input", 9, "right"),
            ("Cache读", 9, "right"),
            ("总Input", 9, "right"),
            ("Output", 9, "right"),
            ("缓存命中", 8, "right"),
        ]
    )
    if show_cost:
        cols.append(("等效费用", 9, "right"))
    if show_tps:
        cols.append(("平均TPS", 9, "right"))
    return cols


def bucket_row(
    label: str,
    b: dict,
    label_w: int = 14,
    show_sessions: bool = False,
    show_tps: bool = False,
    show_cost: bool = True,
    trunc_left: bool = False,
) -> list[str]:
    total_in = b["input_tokens"] + b["cache_read_tokens"]
    turn_step = f"{b['user_turns']}轮{b['turns']}步" if b.get("user_turns") else f"{b['turns']}步"
    row = [trunc_disp(label, label_w, from_left=trunc_left)]
    if show_sessions:
        row.append(str(b["sessions"]))
    row.extend(
        [
            turn_step,
            fmt_tokens(b["input_tokens"]),
            fmt_tokens(b["cache_read_tokens"]),
            fmt_tokens(total_in),
            fmt_tokens(b["output_tokens"]),
            fmt_rate(b),
        ]
    )
    if show_cost:
        row.append(fmt_usd(float(b.get("cost_usd") or 0.0)))
    if show_tps:
        row.append(fmt_avg_tps(b))
    return row


def sanitize_session_for_json(sess: dict) -> dict:
    s = dict(sess)
    s.pop("first_dt", None)
    s.pop("last_dt", None)
    s.pop("user_dates", None)
    cleaned_steps = []
    for st in s.get("steps", []):
        st_copy = dict(st)
        st_copy.pop("dt", None)
        cleaned_steps.append(st_copy)
    s["steps"] = cleaned_steps
    return s


def show_session_detail(sess: dict) -> None:
    sid = sess["session_id"]
    ws_str = ", ".join(sess["workspaces"]) if sess["workspaces"] else "(未知)"
    print(f"=== 会话明细: {sid} ===")
    if sess["title"]:
        print(f"标题: {clean_cell(sess['title'])}")
    if sess.get("subagent_count", 0) > 0:
        print(f"子代理: {sess['subagent_count']} 个 (已合并计入以下统计)")
    print(f"工作区: {ws_str}")
    print(f"日志: {sess['path']}")
    print()
    detail_cols = [
        ("Step", 5, "right"),
        ("本地时间", 19, "left"),
        ("模型", 26, "left"),
        ("新Input", 8, "right"),
        ("Cache读", 8, "right"),
        ("Output", 8, "right"),
        ("命中率", 7, "right"),
    ]
    detail_rows = []
    for st in sess["steps"]:
        dt_str = st["dt"].strftime("%Y-%m-%d %H:%M:%S") if st["dt"] else st["created_at"][:19]
        rate = calc_cache_rate(st["input_tokens"], st["cache_read_tokens"])
        r_str = f"{rate:.1f}%" if rate is not None else "--"
        detail_rows.append(
            [
                str(st["step_index"]),
                dt_str,
                trunc_disp(st["model"], 26),
                fmt_tokens(st["input_tokens"]),
                fmt_tokens(st["cache_read_tokens"]),
                fmt_tokens(st["output_tokens"]),
                r_str,
            ]
        )
    print_table(detail_cols, detail_rows)
    detail_width = sum(w for _, w, _ in detail_cols) + 2 * (len(detail_cols) - 1)
    print("-" * detail_width)
    total_in = sess["input_tokens"] + sess["cache_read_tokens"]
    rate = calc_cache_rate(sess["input_tokens"], sess["cache_read_tokens"])
    r_str = f"{rate:.1f}%" if rate is not None else "--"
    speed_str = ""
    if sess.get("cum_tps") is not None:
        speed_str = (
            f" | 累计有效速度 {sess['cum_tps']:.1f} tok/s "
            f"({fmt_tokens(sess['cum_out'])}/{sess['cum_elapsed']:.1f}s)"
        )
    cost_str = (
        f" | 等效费用 ~{fmt_usd(sess.get('est_cost_usd') or 0.0)}"
        if (sess.get("est_cost_usd") or 0) > 0
        else ""
    )
    print(
        f"合计: {sess['user_turns']}轮{sess['turns']}步 | 新Input {fmt_tokens(sess['input_tokens'])} | "
        f"Cache读 {fmt_tokens(sess['cache_read_tokens'])} | 总Input {fmt_tokens(total_in)} | "
        f"Output {fmt_tokens(sess['output_tokens'])} | 缓存命中率 {r_str}{cost_str}{speed_str}"
    )


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="agy-stats",
        description="统计 agy CLI 本地历史、工作区与当前会话 Token 消耗、轮步数、平均TPS及缓存命中率",
    )
    parser.add_argument(
        "-w", "--workspace", nargs="?", const=".", default=None,
        help="只统计指定工作区(不带路径则默认当前目录)",
    )
    parser.add_argument(
        "-r", "--recursive", action="store_true",
        help="配合 -w 使用，包含子目录工作区",
    )
    parser.add_argument(
        "--by-workspace", action="store_true",
        help="按工作区分组统计全部历史",
    )
    parser.add_argument("--days", type=int, default=0, help="显示最近 N 天的每日明细")
    parser.add_argument("--session", type=str, default="", help="按会话 ID 前缀查看单次会话明细")
    parser.add_argument("--current", action="store_true", help="查看最近一次活跃会话的明细")
    parser.add_argument("--json", action="store_true", help="输出 JSON 格式")
    args = parser.parse_args()

    raw_sessions = load_all_sessions()
    if not raw_sessions:
        print("未找到任何本地 agy 会话记录 (~/.gemini/antigravity-cli/brain/)。")
        return

    all_sessions = fold_subagent_sessions(raw_sessions)

    target_ws = ""
    sessions = all_sessions
    if args.workspace is not None:
        target_ws = os.path.realpath(args.workspace)
        sessions = [
            s for s in all_sessions if match_workspace(s["workspaces"], target_ws, args.recursive)
        ]
        if not sessions:
            print(f"工作区 {target_ws} 下未找到任何历史会话记录。")
            return

    if args.current:
        if args.json:
            print(json.dumps(sanitize_session_for_json(sessions[0]), ensure_ascii=False, indent=2))
        else:
            show_session_detail(sessions[0])
        return

    if args.session:
        matches = [s for s in sessions if s["session_id"].startswith(args.session)]
        if not matches:
            matches = [s for s in raw_sessions if s["session_id"].startswith(args.session)]
        if not matches:
            print(f"未找到前缀为 '{args.session}' 的会话。", file=sys.stderr)
            sys.exit(1)
        if args.json:
            print(json.dumps(sanitize_session_for_json(matches[0]), ensure_ascii=False, indent=2))
        else:
            show_session_detail(matches[0])
        return

    now = datetime.now().astimezone()
    today_date = now.date()
    d7_start = today_date - timedelta(days=6)
    d30_start = today_date - timedelta(days=29)

    summary = {
        "today": make_bucket(),
        "7d": make_bucket(),
        "30d": make_bucket(),
        "all": make_bucket(),
    }
    by_model: dict[str, dict] = defaultdict(make_bucket)
    by_day: dict[str, dict] = defaultdict(make_bucket)
    by_ws: dict[str, dict] = defaultdict(make_bucket)

    for sess in sessions:
        summary["all"]["sessions"] += 1
        sess_days_seen = set()
        for ud in sess.get("user_dates", []):
            summary["all"]["user_turns"] += 1
            by_day[ud.isoformat()]["user_turns"] += 1
            sess_days_seen.add(ud)
            if ud == today_date:
                summary["today"]["user_turns"] += 1
            if ud >= d7_start:
                summary["7d"]["user_turns"] += 1
            if ud >= d30_start:
                summary["30d"]["user_turns"] += 1

        if not sess.get("user_dates") and sess["user_turns"] > 0:
            summary["all"]["user_turns"] += sess["user_turns"]

        ws_keys = sess["workspaces"] or ["(未知工作区)"]
        sess_t_out = int(sess.get("cum_out") or 0)
        sess_t_el = float(sess.get("cum_elapsed") or 0.0)
        if sess_t_el > 0 and sess_t_out > 0:
            summary["all"]["timed_out"] += sess_t_out
            summary["all"]["timed_elapsed"] += sess_t_el

        for wk in ws_keys:
            wb = by_ws[wk]
            wb["sessions"] += 1
            wb["user_turns"] += sess["user_turns"]
            wb["turns"] += sess["turns"]
            wb["input_tokens"] += sess["input_tokens"]
            wb["cache_read_tokens"] += sess["cache_read_tokens"]
            wb["output_tokens"] += sess["output_tokens"]
            wb["cost_usd"] += float(sess.get("est_cost_usd") or 0.0)
            if sess_t_el > 0 and sess_t_out > 0:
                wb["timed_out"] += sess_t_out
                wb["timed_elapsed"] += sess_t_el

        for m_name, mb_t in (sess.get("timing_by_model") or {}).items():
            if m_name not in sess["by_model"]:
                continue
            m_out = int(mb_t.get("out") or 0)
            m_el = float(mb_t.get("elapsed") or 0.0)
            if m_out > 0 and m_el > 0:
                by_model[m_name]["timed_out"] += m_out
                by_model[m_name]["timed_elapsed"] += m_el

        step_days_seen = set()
        for st in sess["steps"]:
            add_step(summary["all"], st)
            add_step(by_model[st["model"]], st)
            if st["dt"]:
                d = st["dt"].date()
                step_days_seen.add(d)
                add_step(by_day[d.isoformat()], st)
                if d == today_date:
                    add_step(summary["today"], st)
                if d >= d7_start:
                    add_step(summary["7d"], st)
                if d >= d30_start:
                    add_step(summary["30d"], st)

        for d in step_days_seen | sess_days_seen:
            by_day[d.isoformat()]["sessions"] += 1
            if d == today_date:
                summary["today"]["sessions"] += 1
            if d >= d7_start:
                summary["7d"]["sessions"] += 1
            if d >= d30_start:
                summary["30d"]["sessions"] += 1

    if args.json:
        def finalize_bucket(b: dict) -> dict:
            out_b = dict(b)
            out_b["cost_usd"] = round(float(out_b.get("cost_usd") or 0.0), 4)
            el = float(out_b.get("timed_elapsed") or 0.0)
            tout = int(out_b.get("timed_out") or 0)
            out_b["timed_elapsed"] = round(el, 3)
            out_b["avg_tps"] = round(tout / el, 2) if (el > 0 and tout > 0) else None
            return out_b

        out = {
            "workspace_filter": target_ws or None,
            "recursive": args.recursive,
            "sessions_count": len(sessions),
            "summary": {k: finalize_bucket(v) for k, v in summary.items()},
            "by_workspace": {k: finalize_bucket(v) for k, v in by_ws.items()},
            "by_model": {k: finalize_bucket(v) for k, v in by_model.items()},
            "by_day": {k: finalize_bucket(v) for k, v in sorted(by_day.items(), reverse=True)},
            "sessions": [
                {
                    "session_id": s["session_id"],
                    "title": s["title"],
                    "workspaces": s["workspaces"],
                    "user_turns": s["user_turns"],
                    "turns": s["turns"],
                    "input_tokens": s["input_tokens"],
                    "cache_read_tokens": s["cache_read_tokens"],
                    "output_tokens": s["output_tokens"],
                    "est_cost_usd": round(float(s.get("est_cost_usd") or 0.0), 4),
                    "cum_tps": s.get("cum_tps"),
                    "subagent_count": int(s.get("subagent_count") or 0),
                }
                for s in sessions
            ],
        }
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return

    scope_title = f"工作区 {target_ws}{' (含子目录)' if args.recursive else ''}" if target_ws else "全部历史"
    print(f"=== agy CLI Token & 缓存统计 [{scope_title}] ===")
    print(f"匹配会话数: {len(sessions)}\n")

    print_table(
        bucket_columns("时间范围", 12, show_sessions=True),
        [
            bucket_row("今日", summary["today"], 12, show_sessions=True),
            bucket_row("近 7 天", summary["7d"], 12, show_sessions=True),
            bucket_row("近 30 天", summary["30d"], 12, show_sessions=True),
            bucket_row("合计", summary["all"], 12, show_sessions=True),
        ],
    )
    print()

    if args.by_workspace or not target_ws:
        ws_rows = [
            bucket_row(wk, b, 24, show_sessions=True, show_tps=True, trunc_left=True)
            for wk, b in sorted(
                by_ws.items(),
                key=lambda kv: kv[1]["input_tokens"] + kv[1]["cache_read_tokens"] + kv[1]["output_tokens"],
                reverse=True,
            )
        ]
        print_table(bucket_columns("工作区分布", 24, show_sessions=True, show_tps=True), ws_rows)
        print()

    model_rows = [
        bucket_row(model, b, 26, show_tps=True)
        for model, b in sorted(
            by_model.items(),
            key=lambda kv: kv[1]["input_tokens"] + kv[1]["cache_read_tokens"] + kv[1]["output_tokens"],
            reverse=True,
        )
    ]
    print_table(bucket_columns("模型分布", 26, show_tps=True), model_rows)
    print()

    if args.days > 0:
        day_rows = []
        for i in range(args.days):
            day_str = (today_date - timedelta(days=i)).isoformat()
            if day_str in by_day:
                day_rows.append(bucket_row(day_str, by_day[day_str], 12, show_sessions=True))
        if day_rows:
            print_table(bucket_columns(f"最近 {args.days} 天", 12, show_sessions=True), day_rows)
            print()

    limit = len(sessions) if target_ws else 10
    hdr_note = "该工作区全部会话" if target_ws else "最近活跃会话"
    print(f"{hdr_note} (`agy-stats -w` 查当前工作区, `--session <ID>` 看明细):")
    sess_cols = [
        ("ID", 9, "left"),
        ("最后活跃", 11, "left"),
        ("轮/步", 10, "right"),
        ("新Input", 8, "right"),
        ("Cache读", 8, "right"),
        ("Output", 8, "right"),
        ("命中率", 7, "right"),
        ("等效费用", 8, "right"),
        ("速度", 9, "right"),
        ("标题 / 工作区", 30, "left"),
    ]
    sess_rows = []
    for s in sessions[:limit]:
        last_str = s["last_dt"].strftime("%m-%d %H:%M") if s["last_dt"] else "--"
        turn_step = f"{s['user_turns']}轮{s['turns']}步"
        spd = f"{s['cum_tps']:.1f}/s" if s.get("cum_tps") is not None else "--"
        ws_short = Path(s["workspaces"][0]).name if s["workspaces"] else "-"
        title = s["title"] or "(无标题)"
        sub_n = int(s.get("subagent_count") or 0)
        sub_tag = f"(+{sub_n}子) " if sub_n > 0 else ""
        desc = f"[{ws_short}] {sub_tag}{title}" if not target_ws else f"{sub_tag}{title}"
        sess_rows.append(
            [
                s["session_id"][:8],
                last_str,
                turn_step,
                fmt_tokens(s["input_tokens"]),
                fmt_tokens(s["cache_read_tokens"]),
                fmt_tokens(s["output_tokens"]),
                fmt_rate(s),
                fmt_usd(float(s.get("est_cost_usd") or 0.0)),
                spd,
                trunc_disp(desc, 30),
            ]
        )
    print_table(sess_cols, sess_rows)


if __name__ == "__main__":
    main()
